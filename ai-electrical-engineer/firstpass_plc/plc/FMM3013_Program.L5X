<Description><![CDATA[Negative of P_FocalDeadband]]></Description>
<Data Format="L5K"><![CDATA[0.00000000e+000]]></Data>
<Data Format="Decorated"><DataValue DataType="REAL" Radix="Float" Value="0.0"/></Data>
</Tag>
<Tag Name="PartInEdge" TagType="Base" DataType="BOOL" Radix="Decimal" Constant="false" ExternalAccess="Read Only">
<Data Format="L5K"><![CDATA[0]]></Data>
<Data Format="Decorated"><DataValue DataType="BOOL" Radix="Decimal" Value="0"/></Data>
</Tag>
<Tag Name="PartInOns" TagType="Base" DataType="BOOL" Radix="Decimal" Constant="false" ExternalAccess="Read Only">
<Data Format="L5K"><![CDATA[0]]></Data>
<Data Format="Decorated"><DataValue DataType="BOOL" Radix="Decimal" Value="0"/></Data>
</Tag>
<Tag Name="PartOutEdge" TagType="Base" DataType="BOOL" Radix="Decimal" Constant="false" ExternalAccess="Read Only">
<Data Format="L5K"><![CDATA[0]]></Data>
<Data Format="Decorated"><DataValue DataType="BOOL" Radix="Decimal" Value="0"/></Data>
</Tag>
<Tag Name="PartOutOns" TagType="Base" DataType="BOOL" Radix="Decimal" Constant="false" ExternalAccess="Read Only">
<Data Format="L5K"><![CDATA[0]]></Data>
<Data Format="Decorated"><DataValue DataType="BOOL" Radix="Decimal" Value="0"/></Data>
</Tag>
<Tag Name="ReciprocatorSpeedCmdPct" TagType="Base" DataType="REAL" Radix="Float" Constant="false" ExternalAccess="Read Only">
<Description><![CDATA[Reciprocator carriage speed command, %]]></Description>
<Data Format="L5K"><![CDATA[0.00000000e+000]]></Data>
<Data Format="Decorated"><DataValue DataType="REAL" Radix="Float" Value="0.0"/></Data>
</Tag>
<Tag Name="SafetyOK_Prev" TagType="Base" DataType="BOOL" Radix="Decimal" Constant="false" ExternalAccess="Read Only">
<Description><![CDATA[SafetyOK last scan]]></Description>
<Data Format="L5K"><![CDATA[0]]></Data>
<Data Format="Decorated"><DataValue DataType="BOOL" Radix="Decimal" Value="0"/></Data>
</Tag>
<Tag Name="UV1_1_WasOn" TagType="Base" DataType="BOOL" Radix="Decimal" Constant="false" ExternalAccess="Read Only">
<Description><![CDATA[UV1-1 has reported lamp-is-on since it was enabled]]></Description>
<Data Format="L5K"><![CDATA[0]]></Data>
<Data Format="Decorated"><DataValue DataType="BOOL" Radix="Decimal" Value="0"/></Data>
</Tag>
<Tag Name="UV1_2_WasOn" TagType="Base" DataType="BOOL" Radix="Decimal" Constant="false" ExternalAccess="Read Only">
<Description><![CDATA[UV1-2 has reported lamp-is-on since it was enabled]]></Description>
<Data Format="L5K"><![CDATA[0]]></Data>
<Data Format="Decorated"><DataValue DataType="BOOL" Radix="Decimal" Value="0"/></Data>
</Tag>
<Tag Name="UV1_3_WasOn" TagType="Base" DataType="BOOL" Radix="Decimal" Constant="false" ExternalAccess="Read Only">
<Description><![CDATA[UV1-3 has reported lamp-is-on since it was enabled]]></Description>
<Data Format="L5K"><![CDATA[0]]></Data>
<Data Format="Decorated"><DataValue DataType="BOOL" Radix="Decimal" Value="0"/></Data>
</Tag>
<Tag Name="UV2_1_WasOn" TagType="Base" DataType="BOOL" Radix="Decimal" Constant="false" ExternalAccess="Read Only">
<Description><![CDATA[UV2-1 has reported lamp-is-on since it was enabled]]></Description>
<Data Format="L5K"><![CDATA[0]]></Data>
<Data Format="Decorated"><DataValue DataType="BOOL" Radix="Decimal" Value="0"/></Data>
</Tag>
<Tag Name="UV2_2_WasOn" TagType="Base" DataType="BOOL" Radix="Decimal" Constant="false" ExternalAccess="Read Only">
<Description><![CDATA[UV2-2 has reported lamp-is-on since it was enabled]]></Description>
<Data Format="L5K"><![CDATA[0]]></Data>
<Data Format="Decorated"><DataValue DataType="BOOL" Radix="Decimal" Value="0"/></Data>
</Tag>
<Tag Name="UV2_3_WasOn" TagType="Base" DataType="BOOL" Radix="Decimal" Constant="false" ExternalAccess="Read Only">
<Description><![CDATA[UV2-3 has reported lamp-is-on since it was enabled]]></Description>
<Data Format="L5K"><![CDATA[0]]></Data>
<Data Format="Decorated"><DataValue DataType="BOOL" Radix="Decimal" Value="0"/></Data>
</Tag>
</Tags>
<Routines>
<Routine Name="R00_Main" Type="RLL">
<Description><![CDATA[Calls every routine once per scan, in order.]]></Description>
<RLLContent>
<Rung Number="0" Type="N">
<Comment><![CDATA[Copy module inputs to named tags]]></Comment>
<Text><![CDATA[JSR(R01_MapInputs,0);]]></Text>
</Rung>
<Rung Number="1" Type="N">
<Comment><![CDATA[Safety status, re-initialise, reset lamp, flasher]]></Comment>
<Text><![CDATA[JSR(R02_Safety,0);]]></Text>
</Rung>
<Rung Number="2" Type="N">
<Comment><![CDATA[UV lamp strike, cooldown, warm-up, intensity]]></Comment>
<Text><![CDATA[JSR(R03_Lamps,0);]]></Text>
</Rung>
<Rung Number="3" Type="N">
<Comment><![CDATA[Automatic permissive, cycle start and cycle stop]]></Comment>
<Text><![CDATA[JSR(R04_Modes,0);]]></Text>
</Rung>
<Rung Number="4" Type="N">
<Comment><![CDATA[Conveyor drive run and speed]]></Comment>
<Text><![CDATA[JSR(R05_Conveyor,0);]]></Text>
</Rung>
<Rung Number="5" Type="N">
<Comment><![CDATA[Focal lift positioning, both screw jacks together]]></Comment>
<Text><![CDATA[JSR(R06_FocalLift,0);]]></Text>
</Rung>
<Rung Number="6" Type="N">
<Comment><![CDATA[Reciprocator run and speed]]></Comment>
<Text><![CDATA[JSR(R07_Recip,0);]]></Text>
</Rung>
<Rung Number="7" Type="N">
<Comment><![CDATA[Part tracking, jam detection, part-left check]]></Comment>
<Text><![CDATA[JSR(R08_Parts,0);]]></Text>
</Rung>
<Rung Number="8" Type="N">
<Comment><![CDATA[Latching alarms and the Faulted summary]]></Comment>
<Text><![CDATA[JSR(R09_Alarms,0);]]></Text>
</Rung>
<Rung Number="9" Type="N">
<Comment><![CDATA[Stack light and horn]]></Comment>
<Text><![CDATA[JSR(R10_Indication,0);]]></Text>
</Rung>
<Rung Number="10" Type="N">
<Comment><![CDATA[Copy named tags to module outputs]]></Comment>
<Text><![CDATA[JSR(R99_MapOutputs,0);]]></Text>
</Rung>
</RLLContent>
</Routine>
<Routine Name="R01_MapInputs" Type="RLL">
<Description><![CDATA[Copy module inputs to named tags]]></Description>
<RLLContent>
<Rung Number="0" Type="N">
<Comment><![CDATA[I:0/00 PRS7001 Incoming Part Photoeye - wire 70011, TS1-1, +EC1, sheet 070]]></Comment>
<Text><![CDATA[XIC(Local:1:I.Pt00.Data)OTE(PRS7001);]]></Text>
</Rung>
<Rung Number="1" Type="N">
<Comment><![CDATA[I:0/01 PRS7002 Outgoing Part Photoeye - wire 70021, TS1-2, +EC1, sheet 070]]></Comment>
<Text><![CDATA[XIC(Local:1:I.Pt01.Data)OTE(PRS7002);]]></Text>
</Rung>
<Rung Number="2" Type="N">
<Comment><![CDATA[I:0/02 CR3202 Upper Row Master Lamp Is On - wire 70031, TS2-1, +EC2, sheet 070]]></Comment>
<Text><![CDATA[XIC(Local:1:I.Pt02.Data)OTE(CR3202_I);]]></Text>
</Rung>
<Rung Number="3" Type="N">
<Comment><![CDATA[I:0/03 CR3204 Upper Row Slave 1 Lamp Is On - wire 70041, TS2-2, +EC2, sheet 070]]></Comment>
<Text><![CDATA[XIC(Local:1:I.Pt03.Data)OTE(CR3204_I);]]></Text>
</Rung>
<Rung Number="4" Type="N">
<Comment><![CDATA[I:0/04 CR3205 Upper Row Slave 2 Lamp Is On - wire 70051, TS2-3, +EC2, sheet 070]]></Comment>
<Text><![CDATA[XIC(Local:1:I.Pt04.Data)OTE(CR3205_I);]]></Text>
</Rung>
<Rung Number="5" Type="N">
<Comment><![CDATA[I:0/05 CR3201 Upper Row System Health - wire 70061, TS2-4, +EC2, sheet 070]]></Comment>
<Text><![CDATA[XIC(Local:1:I.Pt05.Data)OTE(CR3201);]]></Text>
</Rung>
<Rung Number="6" Type="N">
<Comment><![CDATA[I:0/08 CR3112 Safety Relay 1 Monitor - wire 70091, TS4-1, +EC4, sheet 070]]></Comment>
<Text><![CDATA[XIC(Local:1:I.Pt08.Data)OTE(CR3112);]]></Text>
</Rung>
<Rung Number="7" Type="N">
<Comment><![CDATA[I:0/09 GC-S1R Safety Controller Healthy - wire 70101, TS4-2, +EC4, sheet 070]]></Comment>
<Text><![CDATA[XIC(Local:1:I.Pt09.Data)OTE(GC_S1R);]]></Text>
</Rung>
<Rung Number="8" Type="N">
<Comment><![CDATA[I:0/10 PRS7012 Focal Lift High Limit Photoeye - wire 70111, TS4-3, +EC4, sheet 070]]></Comment>
<Text><![CDATA[XIC(Local:1:I.Pt10.Data)OTE(PRS7012);]]></Text>
</Rung>
<Rung Number="9" Type="N">
<Comment><![CDATA[I:0/11 PRS7013 Focal Lift Low Limit Photoeye - wire 70121, TS4-4, +EC4, sheet 070]]></Comment>
<Text><![CDATA[XIC(Local:1:I.Pt11.Data)OTE(PRS7013);]]></Text>
</Rung>
<Rung Number="10" Type="N">
<Comment><![CDATA[I:0/12 CR3208 Lower Row Master Lamp Is On - wire 70131, TS3-1, +EC3, sheet 070]]></Comment>
<Text><![CDATA[XIC(Local:1:I.Pt12.Data)OTE(CR3208_I);]]></Text>
</Rung>
<Rung Number="11" Type="N">
<Comment><![CDATA[I:0/13 CR3210 Lower Row Slave 1 Lamp Is On - wire 70141, TS3-2, +EC3, sheet 070]]></Comment>
<Text><![CDATA[XIC(Local:1:I.Pt13.Data)OTE(CR3210_I);]]></Text>
</Rung>
<Rung Number="12" Type="N">
<Comment><![CDATA[I:0/14 CR3211 Lower Row Slave 2 Lamp Is On - wire 70151, TS3-3, +EC3, sheet 070]]></Comment>
<Text><![CDATA[XIC(Local:1:I.Pt14.Data)OTE(CR3211_I);]]></Text>
</Rung>
<Rung Number="13" Type="N">
<Comment><![CDATA[I:0/15 CR3207 Lower Row System Health - wire 70161, TS3-4, +EC3, sheet 070]]></Comment>
<Text><![CDATA[XIC(Local:1:I.Pt15.Data)OTE(CR3207);]]></Text>
</Rung>
<Rung Number="14" Type="N">
<Comment><![CDATA[AI:2/00 FT7300 Conveyor Encoder Feedback - wire 73011, TS1-11, +EC1, sheet 073]]></Comment>
<Text><![CDATA[MOV(Local:3:I.Ch00.Data,FT7300);]]></Text>
</Rung>
<Rung Number="15" Type="N">
<Comment><![CDATA[AI:2/01 PT7301 Focal Height Position - wire 73021, TS4-10, +EC4, sheet 073]]></Comment>
<Text><![CDATA[MOV(Local:3:I.Ch01.Data,PT7301);]]></Text>
</Rung>
</RLLContent>
</Routine>
<Routine Name="R02_Safety" Type="RLL">
<Description><![CDATA[Safety status, re-initialise, reset lamp, flasher]]></Description>
<RLLContent>
<Rung Number="0" Type="N">
<Comment><![CDATA[The safety function is hardwired through the safety controller (sheet 050). The PLC only watches it: healthy output on AND safety relay 1 picked up.]]></Comment>
<Text><![CDATA[XIC(GC_S1R)XIC(CR3112)OTE(SafetyOK);]]></Text>
</Rung>
<Rung Number="1" Type="N">
<Comment><![CDATA[One-scan pulse when the safety circuit drops: E-stop, door opened or safety fault.]]></Comment>
<Text><![CDATA[XIO(SafetyOK)XIC(SafetyOK_Prev)OTE(SafetyLost);]]></Text>
</Rung>
<Rung Number="2" Type="N">
<Comment><![CDATA[O&M 4.4: after a safety stop, press the monitored reset, then re-initialise from the HMI. Nothing runs until both are done.]]></Comment>
<Text><![CDATA[[XIC(SafetyLost) ,XIC(ReinitRequired) [XIO(HMI_ResetFaults) ,XIO(SafetyOK)]]OTE(ReinitRequired);]]></Text>
</Rung>
<Rung Number="3" Type="N">
<Comment><![CDATA[Remember SafetyOK for the edge above.]]></Comment>
<Text><![CDATA[XIC(SafetyOK)OTE(SafetyOK_Prev);]]></Text>
</Rung>
<Rung Number="4" Type="N">
<Comment><![CDATA[Free-running flasher timer.]]></Comment>
<Text><![CDATA[XIO(FlashTmr.DN)TON(FlashTmr,1000,0);]]></Text>
</Rung>
<Rung Number="5" Type="N">
<Comment><![CDATA[Flash is on for the first half of each period.]]></Comment>
<Text><![CDATA[LES(FlashTmr.ACC,500)OTE(Flash);]]></Text>
</Rung>
<Rung Number="6" Type="N">
<Comment><![CDATA[The illuminated reset button PB7015 flashes while the safety circuit needs a reset.]]></Comment>
<Text><![CDATA[XIO(SafetyOK)XIC(Flash)OTE(CR3115);]]></Text>
</Rung>
</RLLContent>
</Routine>
<Routine Name="R03_Lamps" Type="RLL">
<Description><![CDATA[UV lamp strike, cooldown, warm-up, intensity]]></Description>
<RLLContent>
<Rung Number="0" Type="N">
<Comment><![CDATA[Lamps on from the HMI. Refused during cooldown. Dropped by lamps-off or any safety stop (the safety contactor has already removed lamp power).]]></Comment>
<Text><![CDATA[[XIC(HMI_LampsOn)XIO(CooldownActive) ,XIC(LampsCmd)]XIC(SafetyOK)XIO(ReinitRequired)XIO(HMI_LampsOff)OTE(LampsCmd);]]></Text>
</Rung>
<Rung Number="1" Type="N">
<Comment><![CDATA[Cooldown: the timer runs for 5 minutes after the lamps go off.]]></Comment>
<Text><![CDATA[XIC(LampsCmd)TOF(CooldownTmr,300000,0);]]></Text>
</Rung>
<Rung Number="2" Type="N">
<Comment><![CDATA[Do not re-strike a hot lamp (O&M 4.3). ASSUMED: medium-pressure lamps cannot hot-restrike; confirm against the LightHammer manual.]]></Comment>
<Text><![CDATA[XIC(CooldownTmr.DN)XIO(LampsCmd)OTE(CooldownActive);]]></Text>
</Rung>
<Rung Number="3" Type="N">
<Comment><![CDATA[Strike sequence timer: one module every 1 s to limit inrush.]]></Comment>
<Text><![CDATA[XIC(LampsCmd)TON(StrikeSeqTmr,5000,0);]]></Text>
</Rung>
<Rung Number="4" Type="N">
<Comment><![CDATA[UV1-1 Upper Master (LightHammer 10 Mk II, 6.0 kW): enable at +0 s.]]></Comment>
<Text><![CDATA[XIC(LampsCmd)GEQ(StrikeSeqTmr.ACC,0)OTE(CR3202_O);]]></Text>
</Rung>
<Rung Number="5" Type="N">
<Comment><![CDATA[UV1-1 strike watchdog: enabled but lamp-is-on not made.]]></Comment>
<Text><![CDATA[XIC(CR3202_O)XIO(CR3202_I)TON(UV1_1_StrikeTmr,10000,0);]]></Text>
</Rung>
<Rung Number="6" Type="N">
<Comment><![CDATA[UV1-1 remembers it was lit, so losing the arc can be told apart from never striking.]]></Comment>
<Text><![CDATA[[XIC(CR3202_I) ,XIC(UV1_1_WasOn)]XIC(CR3202_O)OTE(UV1_1_WasOn);]]></Text>
</Rung>
<Rung Number="7" Type="N">
<Comment><![CDATA[UV1-2 Upper Slave 1 (LightHammer 10 Mk II, 6.0 kW): enable at +1 s.]]></Comment>
<Text><![CDATA[XIC(LampsCmd)GEQ(StrikeSeqTmr.ACC,1000)OTE(CR3204_O);]]></Text>
</Rung>
<Rung Number="8" Type="N">
<Comment><![CDATA[UV1-2 strike watchdog: enabled but lamp-is-on not made.]]></Comment>
<Text><![CDATA[XIC(CR3204_O)XIO(CR3204_I)TON(UV1_2_StrikeTmr,10000,0);]]></Text>
</Rung>
<Rung Number="9" Type="N">
<Comment><![CDATA[UV1-2 remembers it was lit, so losing the arc can be told apart from never striking.]]></Comment>
<Text><![CDATA[[XIC(CR3204_I) ,XIC(UV1_2_WasOn)]XIC(CR3204_O)OTE(UV1_2_WasOn);]]></Text>
</Rung>
<Rung Number="10" Type="N">
<Comment><![CDATA[UV1-3 Upper Slave 2 (LightHammer 10 Mk II, 6.0 kW): enable at +2 s.]]></Comment>
<Text><![CDATA[XIC(LampsCmd)GEQ(StrikeSeqTmr.ACC,2000)OTE(CR3205_O);]]></Text>
</Rung>
<Rung Number="11" Type="N">
<Comment><![CDATA[UV1-3 strike watchdog: enabled but lamp-is-on not made.]]></Comment>
<Text><![CDATA[XIC(CR3205_O)XIO(CR3205_I)TON(UV1_3_StrikeTmr,10000,0);]]></Text>
</Rung>
<Rung Number="12" Type="N">
<Comment><![CDATA[UV1-3 remembers it was lit, so losing the arc can be told apart from never striking.]]></Comment>
<Text><![CDATA[[XIC(CR3205_I) ,XIC(UV1_3_WasOn)]XIC(CR3205_O)OTE(UV1_3_WasOn);]]></Text>
</Rung>
<Rung Number="13" Type="N">
<Comment><![CDATA[UV2-1 Lower Master (LightHammer 10 Mk II, 6.0 kW): enable at +3 s.]]></Comment>
<Text><![CDATA[XIC(LampsCmd)GEQ(StrikeSeqTmr.ACC,3000)OTE(CR3208_O);]]></Text>
</Rung>
<Rung Number="14" Type="N">
<Comment><![CDATA[UV2-1 strike watchdog: enabled but lamp-is-on not made.]]></Comment>
<Text><![CDATA[XIC(CR3208_O)XIO(CR3208_I)TON(UV2_1_StrikeTmr,10000,0);]]></Text>
</Rung>
<Rung Number="15" Type="N">
<Comment><![CDATA[UV2-1 remembers it was lit, so losing the arc can be told apart from never striking.]]></Comment>
<Text><![CDATA[[XIC(CR3208_I) ,XIC(UV2_1_WasOn)]XIC(CR3208_O)OTE(UV2_1_WasOn);]]></Text>
</Rung>
<Rung Number="16" Type="N">
<Comment><![CDATA[UV2-2 Lower Slave 1 (LightHammer 10 Mk II, 6.0 kW): enable at +4 s.]]></Comment>
<Text><![CDATA[XIC(LampsCmd)GEQ(StrikeSeqTmr.ACC,4000)OTE(CR3210_O);]]></Text>
</Rung>
<Rung Number="17" Type="N">
<Comment><![CDATA[UV2-2 strike watchdog: enabled but lamp-is-on not made.]]></Comment>
<Text><![CDATA[XIC(CR3210_O)XIO(CR3210_I)TON(UV2_2_StrikeTmr,10000,0);]]></Text>
</Rung>
<Rung Number="18" Type="N">
<Comment><![CDATA[UV2-2 remembers it was lit, so losing the arc can be told apart from never striking.]]></Comment>
<Text><![CDATA[[XIC(CR3210_I) ,XIC(UV2_2_WasOn)]XIC(CR3210_O)OTE(UV2_2_WasOn);]]></Text>
</Rung>
<Rung Number="19" Type="N">
<Comment><![CDATA[UV2-3 Lower Slave 2 (LightHammer 10 Mk II, 6.0 kW): enable at +5 s.]]></Comment>
<Text><![CDATA[XIC(LampsCmd)GEQ(StrikeSeqTmr.ACC,5000)OTE(CR3211_O);]]></Text>
</Rung>
<Rung Number="20" Type="N">
<Comment><![CDATA[UV2-3 strike watchdog: enabled but lamp-is-on not made.]]></Comment>
<Text><![CDATA[XIC(CR3211_O)XIO(CR3211_I)TON(UV2_3_StrikeTmr,10000,0);]]></Text>
</Rung>
<Rung Number="21" Type="N">
<Comment><![CDATA[UV2-3 remembers it was lit, so losing the arc can be told apart from never striking.]]></Comment>
<Text><![CDATA[[XIC(CR3211_I) ,XIC(UV2_3_WasOn)]XIC(CR3211_O)OTE(UV2_3_WasOn);]]></Text>
</Rung>
<Rung Number="22" Type="N">
<Comment><![CDATA[Upper row system-health relay must make once the lamps are commanded on.]]></Comment>
<Text><![CDATA[XIC(LampsCmd)XIO(CR3201)TON(UpperHealthTmr,10000,0);]]></Text>
</Rung>
<Rung Number="23" Type="N">
<Comment><![CDATA[Lower row system-health relay must make once the lamps are commanded on.]]></Comment>
<Text><![CDATA[XIC(LampsCmd)XIO(CR3207)TON(LowerHealthTmr,10000,0);]]></Text>
</Rung>
<Rung Number="24" Type="N">
<Comment><![CDATA[All modules lit and both rows healthy.]]></Comment>
<Text><![CDATA[XIC(LampsCmd)XIC(CR3202_I)XIC(CR3204_I)XIC(CR3205_I)XIC(CR3208_I)XIC(CR3210_I)XIC(CR3211_I)XIC(CR3201)XIC(CR3207)OTE(AllLampsOn);]]></Text>
</Rung>
<Rung Number="25" Type="N">
<Comment><![CDATA[Warm-up before product (O&M 4.2 step 6).]]></Comment>
<Text><![CDATA[XIC(AllLampsOn)TON(WarmUpTmr,60000,0);]]></Text>
</Rung>
<Rung Number="26" Type="N">
<Comment><![CDATA[Lamps ready for automatic.]]></Comment>
<Text><![CDATA[XIC(WarmUpTmr.DN)OTE(LampsReady);]]></Text>
</Rung>
<Rung Number="27" Type="N">
<Comment><![CDATA[Limit HMI_UpperIntensityPct to 100.]]></Comment>
<Text><![CDATA[GRT(HMI_UpperIntensityPct,100.0)MOV(100.0,HMI_UpperIntensityPct);]]></Text>
</Rung>
<Rung Number="28" Type="N">
<Comment><![CDATA[Limit HMI_UpperIntensityPct to 0.]]></Comment>
<Text><![CDATA[LES(HMI_UpperIntensityPct,0.0)MOV(0.0,HMI_UpperIntensityPct);]]></Text>
</Rung>
<Rung Number="29" Type="N">
<Comment><![CDATA[Upper row intensity: 0-100 % -> 0-10 V on SC7401. ASSUMED: the output channel is configured in volts.]]></Comment>
<Text><![CDATA[MUL(HMI_UpperIntensityPct,0.1,SC7401);]]></Text>
</Rung>
<Rung Number="30" Type="N">
<Comment><![CDATA[Limit HMI_LowerIntensityPct to 100.]]></Comment>
<Text><![CDATA[GRT(HMI_LowerIntensityPct,100.0)MOV(100.0,HMI_LowerIntensityPct);]]></Text>
</Rung>
<Rung Number="31" Type="N">
<Comment><![CDATA[Limit HMI_LowerIntensityPct to 0.]]></Comment>
<Text><![CDATA[LES(HMI_LowerIntensityPct,0.0)MOV(0.0,HMI_LowerIntensityPct);]]></Text>
</Rung>
<Rung Number="32" Type="N">
<Comment><![CDATA[Lower row intensity: 0-100 % -> 0-10 V on SC7402. ASSUMED: the output channel is configured in volts.]]></Comment>
<Text><![CDATA[MUL(HMI_LowerIntensityPct,0.1,SC7402);]]></Text>
</Rung>
</RLLContent>
</Routine>
<Routine Name="R04_Modes" Type="RLL">
<Description><![CDATA[Automatic permissive, cycle start and cycle stop]]></Description>
<RLLContent>
<Rung Number="0" Type="N">
<Comment><![CDATA[Automatic is refused while any subsystem is in manual (O&M 4.1).]]></Comment>
<Text><![CDATA[[XIC(HMI_Manual_Lamps) ,XIC(HMI_Manual_Conv) ,XIC(HMI_Manual_Focal) ,XIC(HMI_Manual_Recip)]OTE(AnyManual);]]></Text>
</Rung>
<Rung Number="1" Type="N">
<Comment><![CDATA[Focal position error.]]></Comment>
<Text><![CDATA[SUB(PT7301,HMI_FocalHeightSP,FocalError);]]></Text>
</Rung>
<Rung Number="2" Type="N">
<Comment><![CDATA[Lower edge of the in-position band.]]></Comment>
<Text><![CDATA[MUL(P_FocalDeadband,-1.0,P_FocalDeadbandNeg);]]></Text>
</Rung>
<Rung Number="3" Type="N">
<Comment><![CDATA[O&M 4.1 condition 3: focal lift at its commanded position, between the high and low limit photoeyes.]]></Comment>
<Text><![CDATA[LIM(P_FocalDeadbandNeg,FocalError,P_FocalDeadband)XIO(PRS7012)XIO(PRS7013)OTE(FocalInPosition);]]></Text>
</Rung>
<Rung Number="4" Type="N">
<Comment><![CDATA[Everything automatic needs (O&M 4.1 plus lamps warmed up and no part left in the machine).]]></Comment>
<Text><![CDATA[XIC(SafetyOK)XIO(ReinitRequired)XIO(Faulted)XIO(AnyManual)XIC(FocalInPosition)XIC(LampsReady)XIO(PartsCheckRequired)OTE(AutoPermissive);]]></Text>
</Rung>
<Rung Number="5" Type="N">
<Comment><![CDATA[Reason codes for the HMI, lowest priority first; the last true one wins.]]></Comment>
<Text><![CDATA[MOV(0,AutoBlockReason);]]></Text>
</Rung>
<Rung Number="6" Type="N">
<Comment><![CDATA[5: lamps not lit and warmed up.]]></Comment>
<Text><![CDATA[XIO(LampsReady)MOV(5,AutoBlockReason);]]></Text>
</Rung>
<Rung Number="7" Type="N">
<Comment><![CDATA[4: focal lift not at its setpoint.]]></Comment>
<Text><![CDATA[XIO(FocalInPosition)MOV(4,AutoBlockReason);]]></Text>
</Rung>
<Rung Number="8" Type="N">
<Comment><![CDATA[6: a part may be left in the machine.]]></Comment>
<Text><![CDATA[XIC(PartsCheckRequired)MOV(6,AutoBlockReason);]]></Text>
</Rung>
<Rung Number="9" Type="N">
<Comment><![CDATA[3: a subsystem is in manual; the HMI shows which.]]></Comment>
<Text><![CDATA[XIC(AnyManual)MOV(3,AutoBlockReason);]]></Text>
</Rung>
<Rung Number="10" Type="N">
<Comment><![CDATA[2: an alarm is active.]]></Comment>
<Text><![CDATA[XIC(Faulted)MOV(2,AutoBlockReason);]]></Text>
</Rung>
<Rung Number="11" Type="N">
<Comment><![CDATA[1: safety stop or not re-initialised.]]></Comment>
<Text><![CDATA[[XIO(SafetyOK) ,XIC(ReinitRequired)]MOV(1,AutoBlockReason);]]></Text>
</Rung>
<Rung Number="12" Type="N">
<Comment><![CDATA[Cycle stop (O&M 4.3): stop taking product, keep running until the last part clears.]]></Comment>
<Text><![CDATA[[XIC(HMI_AutoStop)XIC(AutoRequest) ,XIC(CycleStopping)XIC(AutoRequest)]OTE(CycleStopping);]]></Text>
</Rung>
<Rung Number="13" Type="N">
<Comment><![CDATA[Machine is empty.]]></Comment>
<Text><![CDATA[XIC(CycleStopping)EQU(PartsInMachine,0)OTE(CycleStopDone);]]></Text>
</Rung>
<Rung Number="14" Type="N">
<Comment><![CDATA[Automatic request. Drops on cycle stop completion or the moment any permissive is lost.]]></Comment>
<Text><![CDATA[[XIC(HMI_AutoStart)XIO(CycleStopping) ,XIC(AutoRequest)]XIC(AutoPermissive)XIO(CycleStopDone)OTE(AutoRequest);]]></Text>
</Rung>
<Rung Number="15" Type="N">
<Comment><![CDATA[Horn sounds before first motion.]]></Comment>
<Text><![CDATA[XIC(AutoRequest)TON(HornPrewarnTmr,3000,0);]]></Text>
</Rung>
<Rung Number="16" Type="N">
<Comment><![CDATA[Motion allowed after the horn.]]></Comment>
<Text><![CDATA[XIC(AutoRequest)XIC(HornPrewarnTmr.DN)OTE(AutoRunning);]]></Text>
</Rung>
</RLLContent>
</Routine>
<Routine Name="R05_Conveyor" Type="RLL">
<Description><![CDATA[Conveyor drive run and speed]]></Description>
<RLLContent>
<Rung Number="0" Type="N">
<Comment><![CDATA[M-CONV Conveyor belt drive (PowerFlex 525 25B-B012N104) run enable, sheet 072. Runs in automatic, or jogs in manual.]]></Comment>
<Text><![CDATA[[XIC(AutoRunning) ,XIC(HMI_Manual_Conv)XIC(HMI_JogConv)XIO(AutoRequest)]XIC(SafetyOK)XIO(ReinitRequired)OTE(VFD_CONV);]]></Text>
</Rung>
<Rung Number="1" Type="N">
<Comment><![CDATA[Limit HMI_ConvSpeedPct to 100.]]></Comment>
<Text><![CDATA[GRT(HMI_ConvSpeedPct,100.0)MOV(100.0,HMI_ConvSpeedPct);]]></Text>
</Rung>
<Rung Number="2" Type="N">
<Comment><![CDATA[Limit HMI_ConvSpeedPct to 0.]]></Comment>
<Text><![CDATA[LES(HMI_ConvSpeedPct,0.0)MOV(0.0,HMI_ConvSpeedPct);]]></Text>
</Rung>
<Rung Number="3" Type="N">
<Comment><![CDATA[Automatic speed from the HMI recipe.]]></Comment>
<Text><![CDATA[XIC(AutoRunning)MOV(HMI_ConvSpeedPct,ConveyorSpeedCmdPct);]]></Text>
</Rung>
<Rung Number="4" Type="N">
<Comment><![CDATA[Jog speed in manual.]]></Comment>
<Text><![CDATA[XIO(AutoRunning)MOV(P_JogSpeedPct,ConveyorSpeedCmdPct);]]></Text>
</Rung>
<Rung Number="5" Type="N">
<Comment><![CDATA[Zero reference when not running.]]></Comment>
<Text><![CDATA[XIO(VFD_CONV)MOV(0.0,ConveyorSpeedCmdPct);]]></Text>
</Rung>
<Rung Number="6" Type="N">
<Comment><![CDATA[Speed reference SC7403: 0-100 % -> 0-10 V.]]></Comment>
<Text><![CDATA[MUL(ConveyorSpeedCmdPct,0.1,SC7403);]]></Text>
</Rung>
<Rung Number="7" Type="N">
<Comment><![CDATA[Belt must show motion on FT7300 once running. ASSUMED: the channel is scaled 0-100 % speed.]]></Comment>
<Text><![CDATA[XIC(VFD_CONV)LES(FT7300,P_ConvMinFeedbackPct)TON(ConvMotionTmr,3000,0);]]></Text>
</Rung>
</RLLContent>
</Routine>
<Routine Name="R06_FocalLift" Type="RLL">
<Description><![CDATA[Focal lift positioning, both screw jacks together]]></Description>
<RLLContent>
<Rung Number="0" Type="N">
<Comment><![CDATA[Move to setpoint only on an HMI command, never on its own: no unexpected motion.]]></Comment>
<Text><![CDATA[[XIC(HMI_FocalGoToSP) ,XIC(FocalPositioning)]XIC(SafetyOK)XIO(ReinitRequired)XIO(HMI_Manual_Focal)XIO(FocalInPosition)XIO(FocalFault)XIO(AutoRequest)OTE(FocalPositioning);]]></Text>
</Rung>
<Rung Number="1" Type="N">
<Comment><![CDATA[Below setpoint: go up.]]></Comment>
<Text><![CDATA[XIC(FocalPositioning)LES(FocalError,P_FocalDeadbandNeg)OTE(FocalAutoUp);]]></Text>
</Rung>
<Rung Number="2" Type="N">
<Comment><![CDATA[Above setpoint: go down.]]></Comment>
<Text><![CDATA[XIC(FocalPositioning)GRT(FocalError,P_FocalDeadband)OTE(FocalAutoDown);]]></Text>
</Rung>
<Rung Number="3" Type="N">
<Comment><![CDATA[Up: stops at the high limit photoeye.]]></Comment>
<Text><![CDATA[[XIC(FocalAutoUp) ,XIC(HMI_Manual_Focal)XIC(HMI_FocalJogUp)XIO(HMI_FocalJogDown)]XIO(PRS7012)XIC(SafetyOK)XIO(ReinitRequired)XIO(FocalFault)OTE(FocalMoveUp);]]></Text>
</Rung>
<Rung Number="4" Type="N">
<Comment><![CDATA[Down: stops at the low limit photoeye.]]></Comment>
<Text><![CDATA[[XIC(FocalAutoDown) ,XIC(HMI_Manual_Focal)XIC(HMI_FocalJogDown)XIO(HMI_FocalJogUp)]XIO(PRS7013)XIC(SafetyOK)XIO(ReinitRequired)XIO(FocalFault)OTE(FocalMoveDown);]]></Text>
</Rung>
<Rung Number="5" Type="N">
<Comment><![CDATA[VFD_FOCA: both screw jacks always run together so the lamp carriage stays level.]]></Comment>
<Text><![CDATA[[XIC(FocalMoveUp) ,XIC(FocalMoveDown)]OTE(VFD_FOCA);]]></Text>
</Rung>
<Rung Number="6" Type="N">
<Comment><![CDATA[VFD_FOCB: both screw jacks always run together so the lamp carriage stays level.]]></Comment>
<Text><![CDATA[[XIC(FocalMoveUp) ,XIC(FocalMoveDown)]OTE(VFD_FOCB);]]></Text>
</Rung>
<Rung Number="7" Type="N">
<Comment><![CDATA[Move watchdog.]]></Comment>
<Text><![CDATA[[XIC(FocalMoveUp) ,XIC(FocalMoveDown)]TON(FocalMoveTmr,20000,0);]]></Text>
</Rung>
<Rung Number="8" Type="N">
<Comment><![CDATA[Any focal lift alarm stops the lift.]]></Comment>
<Text><![CDATA[[XIC(ALM_FocalTimeout) ,XIC(ALM_FocalLimitSensors) ,XIC(ALM_FocalSetpointRange)]OTE(FocalFault);]]></Text>
</Rung>
</RLLContent>
</Routine>
<Routine Name="R07_Recip" Type="RLL">
<Description><![CDATA[Reciprocator run and speed]]></Description>
<RLLContent>
<Rung Number="0" Type="N">
<Comment><![CDATA[M-RECIP Reciprocator carriage (PowerFlex 525 25B-B8P0N104) run enable, sheet 072. Traverses the lamp carriage while automatic runs, or jogs in manual.]]></Comment>
<Text><![CDATA[[XIC(AutoRunning) ,XIC(HMI_Manual_Recip)XIC(HMI_JogRecip)XIO(AutoRequest)]XIC(SafetyOK)XIO(ReinitRequired)OTE(VFD_RECIP);]]></Text>
</Rung>
<Rung Number="1" Type="N">
<Comment><![CDATA[Limit HMI_RecipSpeedPct to 100.]]></Comment>
<Text><![CDATA[GRT(HMI_RecipSpeedPct,100.0)MOV(100.0,HMI_RecipSpeedPct);]]></Text>
</Rung>
<Rung Number="2" Type="N">
<Comment><![CDATA[Limit HMI_RecipSpeedPct to 0.]]></Comment>
<Text><![CDATA[LES(HMI_RecipSpeedPct,0.0)MOV(0.0,HMI_RecipSpeedPct);]]></Text>
</Rung>
<Rung Number="3" Type="N">
<Comment><![CDATA[Automatic speed from the HMI recipe.]]></Comment>
<Text><![CDATA[XIC(AutoRunning)MOV(HMI_RecipSpeedPct,ReciprocatorSpeedCmdPct);]]></Text>
</Rung>
<Rung Number="4" Type="N">
<Comment><![CDATA[Jog speed in manual.]]></Comment>
<Text><![CDATA[XIO(AutoRunning)MOV(P_JogSpeedPct,ReciprocatorSpeedCmdPct);]]></Text>
</Rung>
<Rung Number="5" Type="N">
<Comment><![CDATA[Zero reference when not running.]]></Comment>
<Text><![CDATA[XIO(VFD_RECIP)MOV(0.0,ReciprocatorSpeedCmdPct);]]></Text>
</Rung>
<Rung Number="6" Type="N">
<Comment><![CDATA[Speed reference SC7404: 0-100 % -> 0-10 V.]]></Comment>
<Text><![CDATA[MUL(ReciprocatorSpeedCmdPct,0.1,SC7404);]]></Text>
</Rung>
</RLLContent>
</Routine>
<Routine Name="R08_Parts" Type="RLL">
<Description><![CDATA[Part tracking, jam detection, part-left check]]></Description>
<RLLContent>
<Rung Number="0" Type="N">
<Comment><![CDATA[A part arrives at the entry photoeye.]]></Comment>
<Text><![CDATA[XIC(PRS7001)ONS(PartInOns)OTE(PartInEdge);]]></Text>
</Rung>
<Rung Number="1" Type="N">
<Comment><![CDATA[A part leaves at the exit photoeye.]]></Comment>
<Text><![CDATA[XIC(PRS7002)ONS(PartOutOns)OTE(PartOutEdge);]]></Text>
</Rung>
<Rung Number="2" Type="N">
<Comment><![CDATA[Count in.]]></Comment>
<Text><![CDATA[XIC(PartInEdge)ADD(PartsInMachine,1,PartsInMachine);]]></Text>
</Rung>
<Rung Number="3" Type="N">
<Comment><![CDATA[Count out.]]></Comment>
<Text><![CDATA[XIC(PartOutEdge)GRT(PartsInMachine,0)SUB(PartsInMachine,1,PartsInMachine);]]></Text>
</Rung>
<Rung Number="4" Type="N">
<Comment><![CDATA[Jam watchdog: restarts every time a part leaves.]]></Comment>
<Text><![CDATA[GRT(PartsInMachine,0)XIC(AutoRunning)XIO(PartOutEdge)TON(JamTmr,30000,0);]]></Text>
</Rung>
<Rung Number="5" Type="N">
<Comment><![CDATA[O&M 4.4: a part left in the machine must be cleared manually before automatic.]]></Comment>
<Text><![CDATA[XIC(SafetyLost)GRT(PartsInMachine,0)OTL(PartsCheckRequired);]]></Text>
</Rung>
<Rung Number="6" Type="N">
<Comment><![CDATA[Operator confirms the machine is clear.]]></Comment>
<Text><![CDATA[XIC(HMI_PartsCleared)XIO(AutoRequest)[MOV(0,PartsInMachine) ,OTU(PartsCheckRequired)];]]></Text>
</Rung>
</RLLContent>
</Routine>
<Routine Name="R09_Alarms" Type="RLL">
<Description><![CDATA[Latching alarms and the Faulted summary]]></Description>
<RLLContent>
<Rung Number="0" Type="N">
<Comment><![CDATA[UV1-1 failed to strike. Latches until the cause clears and Reset is pressed.]]></Comment>
<Text><![CDATA[[XIC(UV1_1_StrikeTmr.DN) ,XIC(ALM_UV1_1_StrikeFail)XIO(HMI_ResetFaults)]OTE(ALM_UV1_1_StrikeFail);]]></Text>
</Rung>
<Rung Number="1" Type="N">
<Comment><![CDATA[UV1-1 arc lost while enabled. Latches until the cause clears and Reset is pressed.]]></Comment>
<Text><![CDATA[[XIC(CR3202_O)XIC(UV1_1_WasOn)XIO(CR3202_I) ,XIC(ALM_UV1_1_LampLost)XIO(HMI_ResetFaults)]OTE(ALM_UV1_1_LampLost);]]></Text>
</Rung>
<Rung Number="2" Type="N">
<Comment><![CDATA[UV1-2 failed to strike. Latches until the cause clears and Reset is pressed.]]></Comment>
<Text><![CDATA[[XIC(UV1_2_StrikeTmr.DN) ,XIC(ALM_UV1_2_StrikeFail)XIO(HMI_ResetFaults)]OTE(ALM_UV1_2_StrikeFail);]]></Text>
</Rung>
<Rung Number="3" Type="N">
<Comment><![CDATA[UV1-2 arc lost while enabled. Latches until the cause clears and Reset is pressed.]]></Comment>
<Text><![CDATA[[XIC(CR3204_O)XIC(UV1_2_WasOn)XIO(CR3204_I) ,XIC(ALM_UV1_2_LampLost)XIO(HMI_ResetFaults)]OTE(ALM_UV1_2_LampLost);]]></Text>
</Rung>
<Rung Number="4" Type="N">
<Comment><![CDATA[UV1-3 failed to strike. Latches until the cause clears and Reset is pressed.]]></Comment>
<Text><![CDATA[[XIC(UV1_3_StrikeTmr.DN) ,XIC(ALM_UV1_3_StrikeFail)XIO(HMI_ResetFaults)]OTE(ALM_UV1_3_StrikeFail);]]></Text>
</Rung>
<Rung Number="5" Type="N">
<Comment><![CDATA[UV1-3 arc lost while enabled. Latches until the cause clears and Reset is pressed.]]></Comment>
<Text><![CDATA[[XIC(CR3205_O)XIC(UV1_3_WasOn)XIO(CR3205_I) ,XIC(ALM_UV1_3_LampLost)XIO(HMI_ResetFaults)]OTE(ALM_UV1_3_LampLost);]]></Text>
</Rung>
<Rung Number="6" Type="N">
<Comment><![CDATA[UV2-1 failed to strike. Latches until the cause clears and Reset is pressed.]]></Comment>
<Text><![CDATA[[XIC(UV2_1_StrikeTmr.DN) ,XIC(ALM_UV2_1_StrikeFail)XIO(HMI_ResetFaults)]OTE(ALM_UV2_1_StrikeFail);]]></Text>
</Rung>
<Rung Number="7" Type="N">
<Comment><![CDATA[UV2-1 arc lost while enabled. Latches until the cause clears and Reset is pressed.]]></Comment>
<Text><![CDATA[[XIC(CR3208_O)XIC(UV2_1_WasOn)XIO(CR3208_I) ,XIC(ALM_UV2_1_LampLost)XIO(HMI_ResetFaults)]OTE(ALM_UV2_1_LampLost);]]></Text>
</Rung>
<Rung Number="8" Type="N">
<Comment><![CDATA[UV2-2 failed to strike. Latches until the cause clears and Reset is pressed.]]></Comment>
<Text><![CDATA[[XIC(UV2_2_StrikeTmr.DN) ,XIC(ALM_UV2_2_StrikeFail)XIO(HMI_ResetFaults)]OTE(ALM_UV2_2_StrikeFail);]]></Text>
</Rung>
<Rung Number="9" Type="N">
<Comment><![CDATA[UV2-2 arc lost while enabled. Latches until the cause clears and Reset is pressed.]]></Comment>
<Text><![CDATA[[XIC(CR3210_O)XIC(UV2_2_WasOn)XIO(CR3210_I) ,XIC(ALM_UV2_2_LampLost)XIO(HMI_ResetFaults)]OTE(ALM_UV2_2_LampLost);]]></Text>
</Rung>
<Rung Number="10" Type="N">
<Comment><![CDATA[UV2-3 failed to strike. Latches until the cause clears and Reset is pressed.]]></Comment>
<Text><![CDATA[[XIC(UV2_3_StrikeTmr.DN) ,XIC(ALM_UV2_3_StrikeFail)XIO(HMI_ResetFaults)]OTE(ALM_UV2_3_StrikeFail);]]></Text>
</Rung>
<Rung Number="11" Type="N">
<Comment><![CDATA[UV2-3 arc lost while enabled. Latches until the cause clears and Reset is pressed.]]></Comment>
<Text><![CDATA[[XIC(CR3211_O)XIC(UV2_3_WasOn)XIO(CR3211_I) ,XIC(ALM_UV2_3_LampLost)XIO(HMI_ResetFaults)]OTE(ALM_UV2_3_LampLost);]]></Text>
</Rung>
<Rung Number="12" Type="N">
<Comment><![CDATA[Upper row lamp system not healthy. Latches until the cause clears and Reset is pressed.]]></Comment>
<Text><![CDATA[[XIC(UpperHealthTmr.DN) ,XIC(ALM_UpperRowHealth)XIO(HMI_ResetFaults)]OTE(ALM_UpperRowHealth);]]></Text>
</Rung>
<Rung Number="13" Type="N">
<Comment><![CDATA[Lower row lamp system not healthy. Latches until the cause clears and Reset is pressed.]]></Comment>
<Text><![CDATA[[XIC(LowerHealthTmr.DN) ,XIC(ALM_LowerRowHealth)XIO(HMI_ResetFaults)]OTE(ALM_LowerRowHealth);]]></Text>
</Rung>
<Rung Number="14" Type="N">
<Comment><![CDATA[Conveyor commanded to run but the belt is not moving. Latches until the cause clears and Reset is pressed.]]></Comment>
<Text><![CDATA[[XIC(ConvMotionTmr.DN) ,XIC(ALM_ConvNoMotion)XIO(HMI_ResetFaults)]OTE(ALM_ConvNoMotion);]]></Text>
</Rung>
<Rung Number="15" Type="N">
<Comment><![CDATA[Focal lift did not reach position in time. Latches until the cause clears and Reset is pressed.]]></Comment>
<Text><![CDATA[[XIC(FocalMoveTmr.DN) ,XIC(ALM_FocalTimeout)XIO(HMI_ResetFaults)]OTE(ALM_FocalTimeout);]]></Text>
</Rung>
<Rung Number="16" Type="N">
<Comment><![CDATA[Both focal limit photoeyes on at once: sensor fault. Latches until the cause clears and Reset is pressed.]]></Comment>
<Text><![CDATA[[XIC(PRS7012)XIC(PRS7013) ,XIC(ALM_FocalLimitSensors)XIO(HMI_ResetFaults)]OTE(ALM_FocalLimitSensors);]]></Text>
</Rung>
<Rung Number="17" Type="N">
<Comment><![CDATA[Focal setpoint is beyond a limit photoeye. Latches until the cause clears and Reset is pressed.]]></Comment>
<Text><![CDATA[[[XIC(FocalAutoUp)XIC(PRS7012) ,XIC(FocalAutoDown)XIC(PRS7013)] ,XIC(ALM_FocalSetpointRange)XIO(HMI_ResetFaults)]OTE(ALM_FocalSetpointRange);]]></Text>
</Rung>
<Rung Number="18" Type="N">
<Comment><![CDATA[Part jam: nothing has left the machine in time. Latches until the cause clears and Reset is pressed.]]></Comment>
<Text><![CDATA[[XIC(JamTmr.DN) ,XIC(ALM_Jam)XIO(HMI_ResetFaults)]OTE(ALM_Jam);]]></Text>
</Rung>
<Rung Number="19" Type="N">
<Comment><![CDATA[Safety stop: E-stop pressed, door open or safety fault. Latches until the cause clears and Reset is pressed.]]></Comment>
<Text><![CDATA[[XIO(SafetyOK) ,XIC(ALM_SafetyStop)XIO(HMI_ResetFaults)]OTE(ALM_SafetyStop);]]></Text>
</Rung>
<Rung Number="20" Type="N">
<Comment><![CDATA[Any alarm.]]></Comment>
<Text><![CDATA[[XIC(ALM_UV1_1_StrikeFail) ,XIC(ALM_UV1_1_LampLost) ,XIC(ALM_UV1_2_StrikeFail) ,XIC(ALM_UV1_2_LampLost) ,XIC(ALM_UV1_3_StrikeFail) ,XIC(ALM_UV1_3_LampLost) ,XIC(ALM_UV2_1_StrikeFail) ,XIC(ALM_UV2_1_LampLost) ,XIC(ALM_UV2_2_StrikeFail) ,XIC(ALM_UV2_2_LampLost) ,XIC(ALM_UV2_3_StrikeFail) ,XIC(ALM_UV2_3_LampLost) ,XIC(ALM_UpperRowHealth) ,XIC(ALM_LowerRowHealth) ,XIC(ALM_ConvNoMotion) ,XIC(ALM_FocalTimeout) ,XIC(ALM_FocalLimitSensors) ,XIC(ALM_FocalSetpointRange) ,XIC(ALM_Jam) ,XIC(ALM_SafetyStop)]OTE(Faulted);]]></Text>
</Rung>
</RLLContent>
</Routine>
<Routine Name="R10_Indication" Type="RLL">
<Description><![CDATA[Stack light and horn]]></Description>
<RLLContent>
<Rung Number="0" Type="N">
<Comment><![CDATA[Red: faulted or safety stop.]]></Comment>
<Text><![CDATA[[XIC(Faulted) ,XIC(ReinitRequired)]OTE(LT7109);]]></Text>
</Rung>
<Rung Number="1" Type="N">
<Comment><![CDATA[Conditions that make amber flash.]]></Comment>
<Text><![CDATA[[XIC(CooldownActive) ,XIC(LampsCmd)XIO(LampsReady) ,XIC(PartsCheckRequired) ,XIC(AutoRequest)XIO(AutoRunning)]OTE(Attention);]]></Text>
</Rung>
<Rung Number="2" Type="N">
<Comment><![CDATA[Amber: stopped. Steady when idle, flashing while waiting on something.]]></Comment>
<Text><![CDATA[XIO(LT7109)XIO(AutoRunning)[XIO(Attention) ,XIC(Flash)]OTE(LT7108);]]></Text>
</Rung>
<Rung Number="3" Type="N">
<Comment><![CDATA[Green: running in automatic.]]></Comment>
<Text><![CDATA[XIO(LT7109)XIC(AutoRunning)OTE(LT7107);]]></Text>
</Rung>
<Rung Number="4" Type="N">
<Comment><![CDATA[Horn: the 3 s warning before first motion.]]></Comment>
<Text><![CDATA[XIC(AutoRequest)XIO(AutoRunning)OTE(HN7110);]]></Text>
</Rung>
</RLLContent>
</Routine>
<Routine Name="R99_MapOutputs" Type="RLL">
<Description><![CDATA[Copy named tags to module outputs]]></Description>
<RLLContent>
<Rung Number="0" Type="N">
<Comment><![CDATA[O:1/00 CR3202 Upper Row Master Lamp Enable - wire 71011, TS2-5, +EC2, sheet 071]]></Comment>
<Text><![CDATA[XIC(CR3202_O)OTE(Local:2:O.Pt00.Data);]]></Text>
</Rung>
<Rung Number="1" Type="N">
<Comment><![CDATA[O:1/01 CR3204 Upper Row Slave 1 Lamp Enable - wire 71021, TS2-6, +EC2, sheet 071]]></Comment>
<Text><![CDATA[XIC(CR3204_O)OTE(Local:2:O.Pt01.Data);]]></Text>
</Rung>
<Rung Number="2" Type="N">
<Comment><![CDATA[O:1/02 CR3205 Upper Row Slave 2 Lamp Enable - wire 71031, TS2-7, +EC2, sheet 071]]></Comment>
<Text><![CDATA[XIC(CR3205_O)OTE(Local:2:O.Pt02.Data);]]></Text>
</Rung>
<Rung Number="3" Type="N">
<Comment><![CDATA[O:1/03 CR3208 Lower Row Master Lamp Enable - wire 71041, TS3-5, +EC3, sheet 071]]></Comment>
<Text><![CDATA[XIC(CR3208_O)OTE(Local:2:O.Pt03.Data);]]></Text>
</Rung>
<Rung Number="4" Type="N">
<Comment><![CDATA[O:1/04 CR3210 Lower Row Slave 1 Lamp Enable - wire 71051, TS3-6, +EC3, sheet 071]]></Comment>
<Text><![CDATA[XIC(CR3210_O)OTE(Local:2:O.Pt04.Data);]]></Text>
</Rung>
<Rung Number="5" Type="N">
<Comment><![CDATA[O:1/05 CR3211 Lower Row Slave 2 Lamp Enable - wire 71061, TS3-7, +EC3, sheet 071]]></Comment>
<Text><![CDATA[XIC(CR3211_O)OTE(Local:2:O.Pt05.Data);]]></Text>
</Rung>
<Rung Number="6" Type="N">
<Comment><![CDATA[O:1/06 LT7107 Stack Light Green - Running - wire 71071, TS1-5, +EC1, sheet 071]]></Comment>
<Text><![CDATA[XIC(LT7107)OTE(Local:2:O.Pt06.Data);]]></Text>
</Rung>
<Rung Number="7" Type="N">
<Comment><![CDATA[O:1/07 LT7108 Stack Light Amber - Warning - wire 71081, TS1-6, +EC1, sheet 071]]></Comment>
<Text><![CDATA[XIC(LT7108)OTE(Local:2:O.Pt07.Data);]]></Text>
</Rung>
<Rung Number="8" Type="N">
<Comment><![CDATA[O:1/08 LT7109 Stack Light Red - Faulted - wire 71091, TS1-7, +EC1, sheet 071]]></Comment>
<Text><![CDATA[XIC(LT7109)OTE(Local:2:O.Pt08.Data);]]></Text>
</Rung>
<Rung Number="9" Type="N">
